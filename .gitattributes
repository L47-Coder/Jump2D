# Normalize text files and keep Unity text assets diffable.
* text=auto

# Source code and serialized Unity assets
*.cs text eol=lf
*.cginc text eol=lf
*.compute text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.json text eol=lf
*.meta text eol=lf
*.asset text eol=lf
*.prefab text eol=lf
*.unity text eol=lf
*.anim text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.mat text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.mixer text eol=lf
*.playable text eol=lf
*.gitattributes text eol=lf
*.gitignore text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.bmp binary
*.tga binary
*.psd binary
*.psb binary
*.exr binary
*.hdr binary
*.fbx binary
*.obj binary
*.blend binary
*.wav binary
*.mp3 binary
*.ogg binary
*.aiff binary
*.mp4 binary
*.mov binary
*.avi binary
*.dll binary
*.so binary
*.dylib binary
*.a binary
*.zip binary
*.7z binary
*.unitypackage binary
